entity-weaponsubmachinegunwt550hos-name = антикварный WT550
entity-weaponsubmachinegunwt550hos-description = Гордость главы СБ. На рукояти выгравированы 24 звезды вокруг пылающего факела, а на стволе засохла кровь...

entity-baseweaponsniper-name = снайперская винтовка (базовая)
entity-baseweaponsniper-description = Для тех, кто предпочитает не шуметь. До первого выстрела.

entity-weaponsnipermosin-name = "Кардашев-Мосин"
entity-weaponsnipermosin-description = Оружие для охоты или бесконечной окопной войны. С штыком. Использует патроны .30.

entity-weaponsnipermosinempty-description = Всё та же винтовка, только пустая. Использует патроны .30.

entity-weaponsniperhristov-name = "Христов"
